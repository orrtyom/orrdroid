<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="orrdroid-test" name="03 · Проверки и автовыбор">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1408" pageHeight="1410">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="Orrdroid · 03 / 04&lt;br&gt;&lt;b&gt;Проверки и автовыбор&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;fontColor=#15263F;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="48" y="20" width="1276.0" height="56" as="geometry" />
        </mxCell>
        <object id="subtitle" label="Проект по ТЗ 0.4 · редакция 2 · 12.11.2026" link="https://github.com/orrtyom/orrdroid/blob/main/docs/orrdroid/diagrams/traffic-flow.v2.json">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;fontColor=#15263F;fontSize=13;fontColor=#536479;" vertex="1" parent="1">
            <mxGeometry x="48" y="82" width="1276.0" height="20" as="geometry" />
          </mxCell>
        </object>
        <object id="kind" label="&lt;b&gt;Тип цели маршрута?&lt;/b&gt;" tooltip="Фиксированная / Auto / цепочка / Tailnet&lt;br&gt;Переход из 02 · Есть проверяемые пути? (Есть proxy / Tailnet)&lt;br&gt;Переход из 02 · Назначенный путь готов? (Нет: разрешённый fallback)">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="388.0" y="112.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="fixed" label="&lt;b&gt;Фиксированный сервер&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Не менять без явного fallback&lt;/span&gt;" tooltip="Не менять без явного fallback">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="54.0" y="276.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="auto" label="&lt;b&gt;Auto: все разрешённые подписки&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Фильтры группы, страны, теги, режим&lt;/span&gt;" tooltip="Фильтры группы, страны, теги, режим">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="276.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="chain" label="&lt;b&gt;Цепочка: выбрать полный путь&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Сервер→сервер / группа→группа&lt;/span&gt;" tooltip="Сервер→сервер / группа→группа&lt;br&gt;Проверять сочетание входа и выхода; независимые пинги ступеней не доказывают работу цепочки. Нет циклов; ограниченный перебор; TCP/UDP/DNS совместимы. Для RU-сервиса при БС проверять именно нужный сервис через цепочку.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="276.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="tail" label="&lt;b&gt;Tailnet: peer / subnet / exit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Проверить реальное назначение&lt;/span&gt;" tooltip="Проверить реальное назначение&lt;br&gt;Требуется реализованный встроенный адаптер в одном VpnService. Direct/DERP и AWG — свойства транспорта; tailscale ping сам по себе не доказывает доступность сервиса. AWG Keqdroid через mihomo не равен готовому Tailscale-AWG.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="276.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="eligible" label="&lt;b&gt;Отфильтровать кандидатов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Страна выхода · ядро · протокол · настройки&lt;/span&gt;" tooltip="Страна выхода · ядро · протокол · настройки&lt;br&gt;Xray или mihomo согласно возможностям. AWG использует поддерживающий backend. Не снимать запрет страны при пустом пуле. TCP-connect не является универсальным фильтром UDP-протоколов. Для российского назначения вне белых списков в БС требуется подтверждённый выход в РФ. Для ограничения доступа из РФ в ЧС требуется подтверждённый выход вне РФ. У цепочки проверять фактический выход последней ступени.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="428.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="schedule" label="&lt;b&gt;Запланировать проверки&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Сначала прошлый рабочий + резерв&lt;/span&gt;" tooltip="Сначала прошлый рабочий + резерв&lt;br&gt;Первый запуск без истории: ограниченный параллельный поиск по всем разрешённым подпискам до готового пути, затем исследование остальных. Полный скан — вручную/после значимых изменений; фон — активные группы, небольшой разнообразный резерв и ротация.&lt;br&gt;Переход из 04 · Откатить или проверить следующего (Следующий / прежний)&lt;br&gt;Переход из 04 · Что изменилось? (Поиск улучшения)&lt;br&gt;Переход из 04 · Подтвердить отказ и искать резерв (Резерв → весь пул)">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="580.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="profile" label="&lt;b&gt;Профиль этой цели?&lt;/b&gt;" tooltip="Общий / TG+Instagram / отдельный&lt;br&gt;После проверки страны подтвердить доступ к назначению через полный путь. Для блокировки или замедления РКН использовать профиль сервиса. Для запрета доступа из РФ дополнительно требуется выход вне РФ.">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="388.0" y="720.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="common" label="&lt;b&gt;Общий доступ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Cloudflare / Google / Mozilla / Apple&lt;/span&gt;" tooltip="Cloudflare / Google / Mozilla / Apple&lt;br&gt;Выбранный малый connectivity endpoint или свой HTTPS URL; ожидаемый ответ версионируется. Расширенный профиль может задавать 2 из 3 независимых целей.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="54.0" y="884.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="instagram" label="&lt;b&gt;Telegram + Instagram&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;instagram.com/favicon.ico или свой URL&lt;/span&gt;" tooltip="instagram.com/favicon.ico или свой URL&lt;br&gt;Общий профиль по проверенному пользователем сценарию. Отдельный Telegram-тест не обязателен. Успех Google не заменяет Instagram; тест favicon не называется полной проверкой Telegram/звонков.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="884.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="custom" label="&lt;b&gt;Отдельный сервисный профиль&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Свой URL / критерий ANY или ALL&lt;/span&gt;" tooltip="Свой URL / критерий ANY или ALL&lt;br&gt;Только если пользователь разделил сервисы. Обязательную цель нельзя скрыто заменить другой. Для нужных маршрутов дополнительные DNS/UDP/протокольные проверки.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="884.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="probe" label="&lt;b&gt;Выполнить принудительную HTTPS-пробу&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Именно кандидат / полная цепочка&lt;/span&gt;" tooltip="Именно кандидат / полная цепочка&lt;br&gt;Не через текущий глобальный узел и без direct fallback. GET, TLS validation, deadline, байтовый лимит, разрешённые redirects; обход локального кеша. Не передавать cookies или пользовательские токены.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="1036.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="body" label="&lt;b&gt;Проверить ответ и передачу&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Статус + тело; cold/warm раздельно&lt;/span&gt;" tooltip="Статус + тело; cold/warm раздельно&lt;br&gt;204 — успех без тела по профилю. Favicon — ожидаемый 200 и завершённое изображение; HTML/login/заглушка не успех. Отдельно TTFB, байты, длительность чтения и этап ошибки.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="1188.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="data" label="&lt;b&gt;Проверить данные перед сменой&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Ограниченный GET + требования маршрута&lt;/span&gt;" tooltip="Ограниченный GET + требования маршрута&lt;br&gt;64–256 КиБ — начальная гипотеза для испытаний; отдельный контролируемый объект и общий deadline, лимит даже при игнорировании Range. При необходимости DNS/UDP. Долгие сессии — ручные/лабораторные тесты.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="1188.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="result" label="&lt;b&gt;Профиль пройден?&lt;/b&gt;" tooltip="По всем обязательным критериям">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="728.0" y="1024.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="reject" label="&lt;b&gt;Записать конкретную причину&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Не исключать узел из всех профилей&lt;/span&gt;" tooltip="Не исключать узел из всех профилей&lt;br&gt;Отказ Instagram не отменяет пригодность для общего доступа. Различать DNS/TLS/timeout, 403/429/5xx, ошибку тела. Отмена и устаревший результат не считаются отказом.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FCE9E8;strokeColor=#C47670;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="1036.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="rank" label="&lt;b&gt;Выбрать устойчивый путь и резерв&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Надёжность → свежесть → разброс → RTT&lt;/span&gt;" tooltip="Надёжность → свежесть → разброс → RTT&lt;br&gt;Кеш: ID полного пути + hash config + ядро/версия + эпоха сети + профиль/версия цели + метод + время. Новый узел с одним успехом не вытесняет устойчивый без наблюдений. Резерв по возможности разных провайдеров/хостов.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="884.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="candidate" label="&lt;b&gt;Есть допущенный кандидат?&lt;/b&gt;" tooltip="Проверен в текущем контексте">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="1068.0" y="720.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="empty" label="&lt;b&gt;Нет подходящего пути&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Диагностика; backoff; явный статус&lt;/span&gt;" tooltip="Диагностика; backoff; явный статус&lt;br&gt;Не ослаблять запреты. Защищённый маршрут заблокирован/частичный доступ. При подозрении общей проблемы цели не объявлять все узлы неисправными. Если обязательную страну выхода подтвердить не удалось, для затронутого трафика показать «нет подходящего маршрута».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FCE9E8;strokeColor=#C47670;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="580.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="out_switch" label="&lt;b&gt;→ 04 · Причина переключения&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Мониторинг и восстановление&lt;/span&gt;" tooltip="Мониторинг и восстановление&lt;br&gt;Продолжение в Orrdroid-04-monitoring-recovery.drawio. Блок «Почему меняем путь?».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#F1E9FF;strokeColor=#9673C4;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="739.0" width="238" height="66" as="geometry" />
          </mxCell>
        </object>
        <object id="out_failure" label="&lt;b&gt;→ 04 · Диагностика отказа&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Мониторинг и восстановление&lt;/span&gt;" tooltip="Мониторинг и восстановление&lt;br&gt;Продолжение в Orrdroid-04-monitoring-recovery.drawio. Блок «Какова причина отказа?».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#F1E9FF;strokeColor=#9673C4;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="435.0" width="238" height="66" as="geometry" />
          </mxCell>
        </object>
