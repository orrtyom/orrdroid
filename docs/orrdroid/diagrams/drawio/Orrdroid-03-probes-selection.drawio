        </mxCell>
        <mxCell id="edge56" value="Tailnet" source="kind" target="tail" edge="1" parent="1" style="edgeStyle=segmentEdgeStyle;rounded=1;arcSize=10;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#4A627B;fontColor=#304458;fontFamily=Inter;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;jettySize=auto;jumpStyle=arc;jumpSize=6;exitX=0.80769;exitY=0.30769;exitPerimeter=0;entryX=0.50000;entryY=0.00000;entryPerimeter=0;">
