  <diagram id="orrdroid-route" name="02 · Правила и маршрутизация">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1742" pageHeight="1410">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="Orrdroid · 02 / 04&lt;br&gt;&lt;b&gt;Правила и маршрутизация&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;fontColor=#15263F;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="48" y="20" width="1610.0" height="56" as="geometry" />
        </mxCell>
        <object id="subtitle" label="Проект по ТЗ 0.4 · редакция 2 · 12.11.2026" link="https://github.com/orrtyom/orrdroid/blob/main/docs/orrdroid/diagrams/traffic-flow.v2.json">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter;fontColor=#15263F;fontSize=13;fontColor=#536479;" vertex="1" parent="1">
            <mxGeometry x="48" y="82" width="1610.0" height="20" as="geometry" />
          </mxCell>
        </object>
        <object id="rules" label="&lt;b&gt;Какой порядок правил?&lt;/b&gt;" tooltip="Совместимый или управляемый&lt;br&gt;Переход из 01 · Зафиксировать режим сети">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="48.0" y="112.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="compat" label="&lt;b&gt;Сохранить порядок Keqdroid&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Включая пользовательское поле order&lt;/span&gt;" tooltip="Включая пользовательское поле order">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="54.0" y="276.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="managed" label="&lt;b&gt;Собрать явные приоритеты&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Ограничения → правила пользователя → пресет&lt;/span&gt;" tooltip="Ограничения → правила пользователя → пресет&lt;br&gt;Обязательные ограничения и явные правила пользователя имеют приоритет. Далее пресет активного режима, разрешённые правила провайдера и fallback.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="276.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="compile" label="&lt;b&gt;Скомпилировать правила и DNS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Overrides, hosts, стабильные ID&lt;/span&gt;" tooltip="Overrides, hosts, стабильные ID&lt;br&gt;Показать итоговый порядок и происхождение правил. При обновлении подписки не менять пользовательскую политику молча. Bootstrap DNS адреса прокси не зависит от ещё не поднятого прокси.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="54.0" y="428.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="scope" label="&lt;b&gt;Как устроен Auto?&lt;/b&gt;" tooltip="Один выход или отдельные группы">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="48.0" y="568.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="global" label="&lt;b&gt;Базовый: один общий выход&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Proxy-правила → GlobalAuto → профиль&lt;/span&gt;" tooltip="Proxy-правила → GlobalAuto → профиль&lt;br&gt;В GlobalAuto пользователь выбирает общий либо TG+Instagram профиль. Direct и block продолжают действовать. Обязательные привязки пресетов к выходу в РФ и вне РФ сохраняются. Если ядро не поддерживает все нужные выходы одновременно, показать конфликт конфигурации.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="54.0" y="732.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="pergroup" label="&lt;b&gt;Расширенный: Auto по маршрутам&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Правило → группа → свой профиль&lt;/span&gt;" tooltip="Правило → группа → свой профиль&lt;br&gt;TG+Instagram по умолчанию вместе; обычные сайты отдельно. Разные выходы одновременно только при поддержке графа outbound/проверенной композиции ядер.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="732.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="bindings" label="&lt;b&gt;Есть проверяемые пути?&lt;/b&gt;" tooltip="Сервер / Auto / цепочка / Tailnet&lt;br&gt;Проверить совместимость ядра и всех обязательных маршрутов. Приложение не угадывает требования каждого сайта: действуют настроенные правила и профили.">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="48.0" y="872.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="traffic" label="&lt;b&gt;Принять новое соединение&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;После активации таблицы маршрутов&lt;/span&gt;" tooltip="После активации таблицы маршрутов&lt;br&gt;Переход из 04 · Подключено / частичный доступ (Новые соединения)">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="124.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="ingress" label="&lt;b&gt;Какой вход?&lt;/b&gt;" tooltip="Android TUN или LAN-прокси">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="1068.0" y="264.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="tun" label="&lt;b&gt;Проверить владельца TUN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Разрешён / запрещён / неизвестен&lt;/span&gt;" tooltip="Разрешён / запрещён / неизвестен&lt;br&gt;Строгий режим: неизвестный UID/ошибка lookup не означает разрешение. DNS/IPv6/UDP/служебные исключения проверяются отдельно. Это проектируемый контракт, не доказанная защита текущего бинарника.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="428.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="lan" label="&lt;b&gt;Проверить LAN-доступ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Выбранный интерфейс + логин/пароль&lt;/span&gt;" tooltip="Выбранный интерфейс + логин/пароль&lt;br&gt;SOCKS5/HTTP включаются локально. Копирование ссылки и QR — для выбранного listener. Отдельный inbound tag; у удалённого клиента нет Android UID. Управляющие API и синхронизация не публикуются как прокси.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1414.0" y="428.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="access" label="&lt;b&gt;Вход разрешён?&lt;/b&gt;" tooltip="Политика TUN либо LAN-аутентификация">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="1068.0" y="568.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="drop" label="&lt;b&gt;Отклонить соединение&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Неавторизованный / запрещённый вход&lt;/span&gt;" tooltip="Неавторизованный / запрещённый вход">
          <mxCell style="rounded=1;arcSize=32;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FCE9E8;strokeColor=#C47670;" vertex="1" parent="1">
            <mxGeometry x="1414.0" y="580.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="match" label="&lt;b&gt;Найти первое совпавшее правило&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;UID / домен / IP / порт / протокол / режим&lt;/span&gt;" tooltip="UID / домен / IP / порт / протокол / режим&lt;br&gt;Использовать применённую таблицу и её порядок. Условия geosite:ru и geoip:ru объединяются через ИЛИ. В БС правило мобильного белого списка идёт непосредственно перед правилом выхода в РФ. В ЧС после трёх категорий исключений действует DIRECT.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="732.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="action" label="&lt;b&gt;Действие правила?&lt;/b&gt;" tooltip="BLOCK / DIRECT / выбранный путь">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="1068.0" y="872.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="block" label="&lt;b&gt;BLOCK: завершить запрос&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Пинг серверов не нужен&lt;/span&gt;" tooltip="Пинг серверов не нужен">
          <mxCell style="rounded=1;arcSize=32;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FCE9E8;strokeColor=#C47670;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="1036.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="direct" label="&lt;b&gt;DIRECT: физическая сеть&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;DNS direct; без прокси-проверок&lt;/span&gt;" tooltip="DNS direct; без прокси-проверок&lt;br&gt;Если direct не работает, не подменять действие другим маршрутом без явно заданной политики. Диагностика direct отделена от проверок узлов.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1414.0" y="1036.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="bound" label="&lt;b&gt;Назначенный путь готов?&lt;/b&gt;" tooltip="Свежий допуск нужного профиля&lt;br&gt;Проверить свежесть допуска нужного профиля и требования к фактической стране выхода. Резерв должен удовлетворять тем же требованиям.">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="1068.0" y="1024.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="forward" label="&lt;b&gt;Передать данные по этому пути&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;DNS согласован; нет direct fallback&lt;/span&gt;" tooltip="DNS согласован; нет direct fallback&lt;br&gt;Для группы — закреплённый активный outbound, для цепочки — весь путь, для Tailnet — заданный peer/subnet/exit. Отказ конкретной группы не требует перезапуска всего VPN.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="1188.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="mode_rules" label="&lt;b&gt;Активен БС или ЧС?&lt;/b&gt;" tooltip="Подтверждённый или заданный вручную режим&lt;br&gt;Пресет действует в управляемой таблице. UNKNOWN сохраняет действующую политику.">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="388.0" y="416.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="bs_rules" label="&lt;b&gt;БС · правила по порядку&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;1. Мобильные белые списки → DIRECT&lt;br&gt;2. geosite:ru или geoip:ru → выход в РФ&lt;br&gt;3. Остальные → правила БС&lt;/span&gt;" tooltip="1. Мобильные белые списки → DIRECT&lt;br&gt;2. geosite:ru или geoip:ru → выход в РФ&lt;br&gt;3. Остальные → правила БС&lt;br&gt;Правило 2 ставится непосредственно после правила 1. Достаточно совпадения домена или IP назначения. Требуется подтверждённый выход в России. У цепочки это фактический выход последней ступени.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="372.0" y="564.0" width="282" height="112" as="geometry" />
          </mxCell>
        </object>
        <object id="cs_rules" label="&lt;b&gt;ЧС · правила по порядку&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;1. Запрет доступа из РФ → выход вне РФ&lt;br&gt;2. Блокировка / замедление РКН → прокси&lt;br&gt;3. Остальные → DIRECT&lt;/span&gt;" tooltip="1. Запрет доступа из РФ → выход вне РФ&lt;br&gt;2. Блокировка / замедление РКН → прокси&lt;br&gt;3. Остальные → DIRECT&lt;br&gt;Списки запрета доступа из России, блокировок РКН и замедлений РКН ведутся отдельно. При пересечении действует требование выхода вне РФ. Прокси проверяется по профилю назначения.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="712.0" y="564.0" width="282" height="112" as="geometry" />
          </mxCell>
        </object>
        <object id="out_kind" label="&lt;b&gt;→ 03 · Тип цели маршрута&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Проверки и автовыбор&lt;/span&gt;" tooltip="Проверки и автовыбор&lt;br&gt;Продолжение в Orrdroid-03-probes-selection.drawio. Блок «Тип цели маршрута?».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#F1E9FF;strokeColor=#9673C4;" vertex="1" parent="1">
            <mxGeometry x="54.0" y="1043.0" width="238" height="66" as="geometry" />
          </mxCell>
        </object>
        <object id="out_transaction" label="&lt;b&gt;→ 04 · Применение маршрута&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Мониторинг и восстановление&lt;/span&gt;" tooltip="Мониторинг и восстановление&lt;br&gt;Продолжение в Orrdroid-04-monitoring-recovery.drawio. Блок «Применить один переход».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#F1E9FF;strokeColor=#9673C4;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="1043.0" width="238" height="66" as="geometry" />
          </mxCell>
        </object>
        <object id="out_monitor" label="&lt;b&gt;→ 04 · Мониторинг маршрутов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Мониторинг и восстановление&lt;/span&gt;" tooltip="Мониторинг и восстановление&lt;br&gt;Продолжение в Orrdroid-04-monitoring-recovery.drawio. Блок «Следить за активными маршрутами».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#F1E9FF;strokeColor=#9673C4;" vertex="1" parent="1">
            <mxGeometry x="1414.0" y="1195.0" width="238" height="66" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge26" value="Совместимый" source="rules" target="compat" edge="1" parent="1" style="edgeStyle=segmentEdgeStyle;rounded=1;arcSize=10;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#4A627B;fontColor=#304458;fontFamily=Inter;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;jettySize=auto;jumpStyle=arc;jumpSize=6;exitX=0.50000;exitY=1.00000;exitPerimeter=0;entryX=0.50000;entryY=0.00000;entryPerimeter=0;">
