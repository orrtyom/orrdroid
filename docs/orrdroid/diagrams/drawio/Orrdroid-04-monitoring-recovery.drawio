        </object>
        <object id="out_network" label="&lt;b&gt;→ 01 · Физическая сеть&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Запуск и определение сети&lt;/span&gt;" tooltip="Запуск и определение сети&lt;br&gt;Продолжение в Orrdroid-01-startup-network.drawio. Блок «Привязаться к физической сети».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#F1E9FF;strokeColor=#9673C4;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="1195.0" width="238" height="66" as="geometry" />
          </mxCell>
        </object>
        <object id="out_validate" label="&lt;b&gt;→ 01 · Применение настроек&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Запуск и определение сети&lt;/span&gt;" tooltip="Запуск и определение сети&lt;br&gt;Продолжение в Orrdroid-01-startup-network.drawio. Блок «Проверить и применить настройки».">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#F1E9FF;strokeColor=#9673C4;" vertex="1" parent="1">
