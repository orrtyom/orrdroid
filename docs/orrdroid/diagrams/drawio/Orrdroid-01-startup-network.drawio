        <object id="start" label="&lt;b&gt;Запуск / возврат в приложение&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Также: команда «Подключить»&lt;/span&gt;" tooltip="Также: команда «Подключить»">
