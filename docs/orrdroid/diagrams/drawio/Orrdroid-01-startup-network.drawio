        <object id="service" label="&lt;b&gt;Сервис уже работает?&lt;/b&gt;" tooltip="Сверить реальное состояние">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="48.0" y="264.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="intent" label="&lt;b&gt;Нужно подключение?&lt;/b&gt;" tooltip="Команда или разрешённая автополитика&lt;br&gt;Переход из 04 · Повторить с ограниченным backoff (Сверить намерение)">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="48.0" y="416.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="stopped" label="&lt;b&gt;Остановлено пользователем&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Автоматика не поднимает туннель&lt;/span&gt;" tooltip="Автоматика не поднимает туннель&lt;br&gt;Переход из 04 · Зафиксировать ручную остановку (Отключено)">
          <mxCell style="rounded=1;arcSize=32;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#E4F5EB;strokeColor=#51906C;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="428.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="config" label="&lt;b&gt;Есть пригодная конфигурация?&lt;/b&gt;" tooltip="Первый запуск: обычно нет">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="48.0" y="568.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="import" label="&lt;b&gt;Добавить конфигурацию&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Подписка / файл / защищённая синхронизация&lt;/span&gt;" tooltip="Подписка / файл / защищённая синхронизация&lt;br&gt;URL подписки обновляется через доступный разрешённый bootstrap-путь. Если его нет — локальный импорт или восстановление сети. Нет бесконечного цикла ожидания прокси, который ещё не создан.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="580.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="sync" label="&lt;b&gt;Режим синхронизации?&lt;/b&gt;" tooltip="Tailnet / LAN / backup / сервис">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="728.0" y="568.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="master" label="&lt;b&gt;Главное → ведомые&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Главное нельзя перезаписать с ведомого&lt;/span&gt;" tooltip="Главное нельзя перезаписать с ведомого&lt;br&gt;Режим, роли и новая эпоха меняются владельцем явно. Сопряжение, подпись и шифрование обязательны.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="428.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="merge" label="&lt;b&gt;Изменения всех устройств&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Версии полей, конфликты, удаления&lt;/span&gt;" tooltip="Версии полей, конфликты, удаления&lt;br&gt;Не просто время изменения целого файла. Стабильные ID, причинный порядок, tombstones и очередь офлайн-правок. WebDAV/Nextcloud — отдельные адаптеры.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="1074.0" y="580.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="validate" label="&lt;b&gt;Проверить и применить настройки&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Dry run, миграции, атомарность, откат&lt;/span&gt;" tooltip="Dry run, миграции, атомарность, откат&lt;br&gt;Обмениваемся настройками и подписками, но не локальными пингами, сетевым состоянием и активным узлом. Полученные настройки не включают LAN-listener автоматически.&lt;br&gt;Переход из 04 · Подписка / правила / ручной выбор (Новая версия)">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="732.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="vpn" label="&lt;b&gt;Разрешение VPN получено?&lt;/b&gt;" tooltip="И конфигурация поддерживается">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="48.0" y="720.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="awaituser" label="&lt;b&gt;Нужно действие пользователя&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Разрешение / исправление / импорт&lt;/span&gt;" tooltip="Разрешение / исправление / импорт">
          <mxCell style="rounded=1;arcSize=32;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FCE9E8;strokeColor=#C47670;" vertex="1" parent="1">
            <mxGeometry x="54.0" y="884.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="network" label="&lt;b&gt;Привязаться к физической сети&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Новая эпоха: отменить старые проверки&lt;/span&gt;" tooltip="Новая эпоха: отменить старые проверки&lt;br&gt;Wi-Fi / мобильная сеть / восстановление после сна. Результаты другой сети не разрешают переключение.&lt;br&gt;Переход из 04 · Смена сети или пробуждение (Перепроверить)">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="732.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="online" label="&lt;b&gt;Есть сеть без portal?&lt;/b&gt;" tooltip="Нет связи / portal / доступна">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="388.0" y="872.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="waitnet" label="&lt;b&gt;Ожидать доступную сеть&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Backoff; не штрафовать все узлы&lt;/span&gt;" tooltip="Backoff; не штрафовать все узлы&lt;br&gt;Captive portal требует явного входа. Проверки сети соблюдают запрет direct; при недостатке сведений состояние UNKNOWN.&lt;br&gt;Переход из 04 · Какова причина отказа? (Сеть / portal)">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF0DF;strokeColor=#BD8A51;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="884.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="netpolicy" label="&lt;b&gt;Режим задан вручную?&lt;/b&gt;" tooltip="БС / ЧС либо Авто">
          <mxCell style="rhombus;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#FFF4D9;strokeColor=#B88633;" vertex="1" parent="1">
            <mxGeometry x="388.0" y="1024.0" width="250" height="104" as="geometry" />
          </mxCell>
        </object>
        <object id="detect" label="&lt;b&gt;Определить режим напрямую&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;Несколько целей, debounce, подтверждение&lt;/span&gt;" tooltip="Несколько целей, debounce, подтверждение&lt;br&gt;Только через выбранную физическую сеть и при разрешённых direct-пробах. Успех VPN не классифицирует сеть. Неоднозначность → UNKNOWN; прежний режим лишь устаревшая подсказка.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="734.0" y="1036.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="mode" label="&lt;b&gt;Зафиксировать режим сети&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#40556E&quot;&gt;БС / ЧС / UNKNOWN + эпоха&lt;/span&gt;" tooltip="БС / ЧС / UNKNOWN + эпоха&lt;br&gt;БС — гипотеза доступности, а не доказанная политика оператора. Метка провайдера не заменяет фактические проверки.">
          <mxCell style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter;fontSize=15;fontColor=#15263F;strokeWidth=1.35;fillColor=#EAF2FF;strokeColor=#6790C2;" vertex="1" parent="1">
            <mxGeometry x="394.0" y="1188.0" width="238" height="80" as="geometry" />
          </mxCell>
        </object>
