  "nodes": [
    {
      "g": "life",
      "id": "start",
      "row": 0,
      "col": 0,
      "type": "terminator",
      "title": "Запуск / возврат в приложение",
      "body": "Также: команда «Подключить»",
      "note": ""
    },
    {
      "g": "life",
      "id": "service",
      "row": 1,
      "col": 0,
      "type": "decision",
      "title": "Сервис уже работает?",
      "body": "Сверить реальное состояние",
      "note": ""
    },
    {
      "g": "life",
      "id": "intent",
      "row": 2,
      "col": 0,
      "type": "decision",
      "title": "Нужно подключение?",
      "body": "Команда или разрешённая автополитика",
      "note": ""
    },
    {
      "g": "life",
      "id": "stopped",
      "row": 2,
      "col": 1,
      "type": "terminator",
      "title": "Остановлено пользователем",
      "body": "Автоматика не поднимает туннель",
      "note": ""
    },
    {
      "g": "life",
      "id": "config",
      "row": 3,
      "col": 0,
      "type": "decision",
      "title": "Есть пригодная конфигурация?",
      "body": "Первый запуск: обычно нет",
      "note": ""
    },
    {
      "g": "life",
      "id": "import",
      "row": 3,
      "col": 1,
      "type": "process",
      "title": "Добавить конфигурацию",
      "body": "Подписка / файл / защищённая синхронизация",
      "note": "URL подписки обновляется через доступный разрешённый bootstrap-путь. Если его нет — локальный импорт или восстановление сети. Нет бесконечного цикла ожидания прокси, который ещё не создан."
    },
    {
      "g": "life",
      "id": "sync",
      "row": 4,
      "col": 1,
      "type": "decision",
      "title": "Режим синхронизации?",
      "body": "Tailnet / LAN / backup / сервис",
      "note": ""
    },
    {
      "g": "life",
      "id": "master",
      "row": 5,
      "col": 0,
      "type": "process",
      "title": "Главное → ведомые",
      "body": "Главное нельзя перезаписать с ведомого",
      "note": "Режим, роли и новая эпоха меняются владельцем явно. Сопряжение, подпись и шифрование обязательны."
    },
    {
      "g": "life",
      "id": "merge",
      "row": 5,
      "col": 1,
      "type": "process",
      "title": "Изменения всех устройств",
      "body": "Версии полей, конфликты, удаления",
      "note": "Не просто время изменения целого файла. Стабильные ID, причинный порядок, tombstones и очередь офлайн-правок. WebDAV/Nextcloud — отдельные адаптеры."
    },
    {
      "g": "life",
      "id": "validate",
      "row": 6,
      "col": 0,
      "type": "process",
      "title": "Проверить и применить настройки",
      "body": "Dry run, миграции, атомарность, откат",
      "note": "Обмениваемся настройками и подписками, но не локальными пингами, сетевым состоянием и активным узлом. Полученные настройки не включают LAN-listener автоматически."
    },
    {
      "g": "life",
      "id": "vpn",
      "row": 7,
      "col": 0,
      "type": "decision",
      "title": "Разрешение VPN получено?",
      "body": "И конфигурация поддерживается",
      "note": ""
    },
    {
      "g": "life",
      "id": "awaituser",
      "row": 7,
      "col": 1,
      "type": "terminator",
      "title": "Нужно действие пользователя",
      "body": "Разрешение / исправление / импорт",
      "note": ""
    },
    {
      "g": "life",
      "id": "network",
      "row": 8,
      "col": 0,
      "type": "process",
      "title": "Привязаться к физической сети",
      "body": "Новая эпоха: отменить старые проверки",
      "note": "Wi-Fi / мобильная сеть / восстановление после сна. Результаты другой сети не разрешают переключение."
    },
    {
      "g": "life",
      "id": "online",
      "row": 9,
      "col": 0,
      "type": "decision",
      "title": "Есть сеть без portal?",
      "body": "Нет связи / portal / доступна",
      "note": ""
    },
    {
      "g": "life",
      "id": "waitnet",
      "row": 9,
      "col": 1,
      "type": "process",
      "title": "Ожидать доступную сеть",
      "body": "Backoff; не штрафовать все узлы",
      "note": "Captive portal требует явного входа. Проверки сети соблюдают запрет direct; при недостатке сведений состояние UNKNOWN."
    },
    {
      "g": "life",
      "id": "netpolicy",
      "row": 10,
      "col": 0,
      "type": "decision",
      "title": "Режим задан вручную?",
      "body": "БС / ЧС либо Авто",
      "note": ""
    },
    {
      "g": "life",
      "id": "detect",
      "row": 10,
      "col": 1,
      "type": "process",
      "title": "Определить режим напрямую",
      "body": "Несколько целей, debounce, подтверждение",
      "note": "Только через выбранную физическую сеть и при разрешённых direct-пробах. Успех VPN не классифицирует сеть. Неоднозначность → UNKNOWN; прежний режим лишь устаревшая подсказка."
    },
    {
      "g": "life",
      "id": "mode",
      "row": 11,
      "col": 0,
      "type": "process",
      "title": "Зафиксировать режим сети",
      "body": "БС / ЧС / UNKNOWN + эпоха",
      "note": "БС — гипотеза доступности, а не доказанная политика оператора. Метка провайдера не заменяет фактические проверки. Пресет выбирается по подтверждённому режиму либо явному ручному выбору. UNKNOWN сохраняет действующую политику."
    },
    {
      "g": "route",
      "id": "rules",
      "row": 0,
      "col": 0,
      "type": "decision",
      "title": "Какой порядок правил?",
      "body": "Совместимый или управляемый",
      "note": ""
    },
    {
      "g": "route",
      "id": "compat",
      "row": 1,
      "col": 0,
      "type": "process",
      "title": "Сохранить порядок Keqdroid",
      "body": "Включая пользовательское поле order",
      "note": ""
    },
    {
      "g": "route",
      "id": "managed",
      "row": 1,
      "col": 1,
      "type": "process",
      "title": "Собрать явные приоритеты",
      "body": "Ограничения → правила пользователя → пресет",
      "note": "Обязательные ограничения и явные правила пользователя имеют приоритет. Далее пресет активного режима, разрешённые правила провайдера и fallback."
    },
    {
      "g": "route",
      "id": "compile",
      "row": 2,
      "col": 0,
      "type": "process",
      "title": "Скомпилировать правила и DNS",
      "body": "Overrides, hosts, стабильные ID",
      "note": "Показать итоговый порядок и происхождение правил. При обновлении подписки не менять пользовательскую политику молча. Bootstrap DNS адреса прокси не зависит от ещё не поднятого прокси."
    },
    {
      "g": "route",
      "id": "scope",
      "row": 3,
      "col": 0,
      "type": "decision",
      "title": "Как устроен Auto?",
      "body": "Один выход или отдельные группы",
      "note": ""
    },
    {
      "g": "route",
      "id": "global",
      "row": 4,
      "col": 0,
      "type": "process",
      "title": "Базовый: один общий выход",
      "body": "Proxy-правила → GlobalAuto → профиль",
      "note": "В GlobalAuto пользователь выбирает общий либо TG+Instagram профиль. Direct и block продолжают действовать. Обязательные привязки пресетов к выходу в РФ и вне РФ сохраняются. Если ядро не поддерживает все нужные выходы одновременно, показать конфликт конфигурации."
    },
    {
      "g": "route",
      "id": "pergroup",
      "row": 4,
      "col": 1,
      "type": "process",
      "title": "Расширенный: Auto по маршрутам",
      "body": "Правило → группа → свой профиль",
      "note": "TG+Instagram по умолчанию вместе; обычные сайты отдельно. Разные выходы одновременно только при поддержке графа outbound/проверенной композиции ядер."
    },
    {
      "g": "route",
      "id": "bindings",
      "row": 5,
      "col": 0,
      "type": "decision",
      "title": "Есть проверяемые пути?",
      "body": "Сервер / Auto / цепочка / Tailnet",
      "note": "Проверить совместимость ядра и всех обязательных маршрутов. Приложение не угадывает требования каждого сайта: действуют настроенные правила и профили."
    },
    {
      "g": "route",
      "id": "traffic",
      "row": 6,
      "col": 0,
      "type": "process",
      "title": "Принять новое соединение",
      "body": "После активации таблицы маршрутов",
      "note": ""
    },
    {
      "g": "route",
      "id": "ingress",
      "row": 7,
      "col": 0,
      "type": "decision",
      "title": "Какой вход?",
      "body": "Android TUN или LAN-прокси",
      "note": ""
    },
    {
      "g": "route",
      "id": "tun",
      "row": 8,
      "col": 0,
      "type": "process",
      "title": "Проверить владельца TUN",
      "body": "Разрешён / запрещён / неизвестен",
      "note": "Строгий режим: неизвестный UID/ошибка lookup не означает разрешение. DNS/IPv6/UDP/служебные исключения проверяются отдельно. Это проектируемый контракт, не доказанная защита текущего бинарника."
    },
    {
      "g": "route",
      "id": "lan",
      "row": 8,
      "col": 1,
      "type": "process",
      "title": "Проверить LAN-доступ",
      "body": "Выбранный интерфейс + логин/пароль",
      "note": "SOCKS5/HTTP включаются локально. Копирование ссылки и QR — для выбранного listener. Отдельный inbound tag; у удалённого клиента нет Android UID. Управляющие API и синхронизация не публикуются как прокси."
    },
    {
      "g": "route",
      "id": "access",
      "row": 9,
      "col": 0,
      "type": "decision",
      "title": "Вход разрешён?",
      "body": "Политика TUN либо LAN-аутентификация",
      "note": ""
    },
    {
      "g": "route",
      "id": "drop",
      "row": 9,
      "col": 1,
      "type": "terminator",
      "title": "Отклонить соединение",
      "body": "Неавторизованный / запрещённый вход",
      "note": ""
    },
    {
      "g": "route",
      "id": "match",
      "row": 10,
      "col": 0,
      "type": "process",
      "title": "Найти первое совпавшее правило",
      "body": "UID / домен / IP / порт / протокол / режим",
      "note": "Использовать применённую таблицу и её порядок. Условия geosite:ru и geoip:ru объединяются через ИЛИ. В БС правило мобильного белого списка идёт непосредственно перед правилом выхода в РФ. В ЧС после трёх категорий исключений действует DIRECT."
    },
    {
      "g": "route",
      "id": "action",
      "row": 11,
      "col": 0,
      "type": "decision",
      "title": "Действие правила?",
      "body": "BLOCK / DIRECT / выбранный путь",
      "note": ""
    },
    {
      "g": "route",
      "id": "block",
      "row": 12,
      "col": 1,
      "type": "terminator",
      "title": "BLOCK: завершить запрос",
      "body": "Пинг серверов не нужен",
      "note": ""
    },
    {
      "g": "route",
      "id": "direct",
      "row": 12,
      "col": 0,
      "type": "process",
      "title": "DIRECT: физическая сеть",
      "body": "DNS direct; без прокси-проверок",
      "note": "Если direct не работает, не подменять действие другим маршрутом без явно заданной политики. Диагностика direct отделена от проверок узлов."
    },
    {
      "g": "route",
      "id": "bound",
      "row": 13,
      "col": 0,
      "type": "decision",
      "title": "Назначенный путь готов?",
      "body": "Свежий допуск нужного профиля",
      "note": "Проверить свежесть допуска нужного профиля и требования к фактической стране выхода. Резерв должен удовлетворять тем же требованиям."
    },
    {
      "g": "route",
      "id": "forward",
      "row": 14,
      "col": 0,
      "type": "process",
      "title": "Передать данные по этому пути",
      "body": "DNS согласован; нет direct fallback",
      "note": "Для группы — закреплённый активный outbound, для цепочки — весь путь, для Tailnet — заданный peer/subnet/exit. Отказ конкретной группы не требует перезапуска всего VPN."
    },
    {
      "g": "test",
      "id": "kind",
      "row": 0,
      "col": 0,
      "type": "decision",
      "title": "Тип цели маршрута?",
      "body": "Фиксированная / Auto / цепочка / Tailnet",
      "note": ""
    },
    {
      "g": "test",
      "id": "fixed",
      "row": 1,
      "col": 0,
      "type": "process",
      "title": "Фиксированный сервер",
      "body": "Не менять без явного fallback",
      "note": ""
    },
    {
      "g": "test",
      "id": "auto",
      "row": 1,
      "col": 1,
      "type": "process",
      "title": "Auto: все разрешённые подписки",
      "body": "Фильтры группы, страны, теги, режим",
      "note": ""
    },
    {
      "g": "test",
      "id": "chain",
      "row": 2,
      "col": 0,
      "type": "process",
      "title": "Цепочка: выбрать полный путь",
      "body": "Сервер→сервер / группа→группа",
      "note": "Проверять сочетание входа и выхода; независимые пинги ступеней не доказывают работу цепочки. Нет циклов; ограниченный перебор; TCP/UDP/DNS совместимы. Для RU-сервиса при БС проверять именно нужный сервис через цепочку."
    },
    {
      "g": "test",
      "id": "tail",
      "row": 2,
      "col": 1,
      "type": "process",
      "title": "Tailnet: peer / subnet / exit",
      "body": "Проверить реальное назначение",
      "note": "Требуется реализованный встроенный адаптер в одном VpnService. Direct/DERP и AWG — свойства транспорта; tailscale ping сам по себе не доказывает доступность сервиса. AWG Keqdroid через mihomo не равен готовому Tailscale-AWG."
    },
    {
      "g": "test",
      "id": "eligible",
      "row": 3,
      "col": 0,
      "type": "process",
      "title": "Отфильтровать кандидатов",
      "body": "Страна выхода · ядро · протокол · настройки",
      "note": "Xray или mihomo согласно возможностям. AWG использует поддерживающий backend. Не снимать запрет страны при пустом пуле. TCP-connect не является универсальным фильтром UDP-протоколов. Для российского назначения вне белых списков в БС требуется подтверждённый выход в РФ. Для ограничения доступа из РФ в ЧС требуется подтверждённый выход вне РФ. У цепочки проверять фактический выход последней ступени."
    },
    {
      "g": "test",
      "id": "schedule",
      "row": 4,
      "col": 0,
      "type": "process",
      "title": "Запланировать проверки",
      "body": "Сначала прошлый рабочий + резерв",
      "note": "Первый запуск без истории: ограниченный параллельный поиск по всем разрешённым подпискам до готового пути, затем исследование остальных. Полный скан — вручную/после значимых изменений; фон — активные группы, небольшой разнообразный резерв и ротация."
    },
    {
      "g": "test",
      "id": "profile",
      "row": 5,
      "col": 0,
      "type": "decision",
      "title": "Профиль этой цели?",
      "body": "Общий / TG+Instagram / отдельный",
      "note": "После проверки страны подтвердить доступ к назначению через полный путь. Для блокировки или замедления РКН использовать профиль сервиса. Для запрета доступа из РФ дополнительно требуется выход вне РФ."
    },
    {
      "g": "test",
      "id": "common",
      "row": 6,
      "col": 0,
      "type": "process",
      "title": "Общий доступ",
      "body": "Cloudflare / Google / Mozilla / Apple",
      "note": "Выбранный малый connectivity endpoint или свой HTTPS URL; ожидаемый ответ версионируется. Расширенный профиль может задавать 2 из 3 независимых целей."
    },
    {
      "g": "test",
      "id": "instagram",
      "row": 6,
      "col": 1,
      "type": "process",
      "title": "Telegram + Instagram",
      "body": "instagram.com/favicon.ico или свой URL",
      "note": "Общий профиль по проверенному пользователем сценарию. Отдельный Telegram-тест не обязателен. Успех Google не заменяет Instagram; тест favicon не называется полной проверкой Telegram/звонков."
    },
    {
      "g": "test",
      "id": "custom",
      "row": 7,
      "col": 1,
      "type": "process",
      "title": "Отдельный сервисный профиль",
      "body": "Свой URL / критерий ANY или ALL",
      "note": "Только если пользователь разделил сервисы. Обязательную цель нельзя скрыто заменить другой. Для нужных маршрутов дополнительные DNS/UDP/протокольные проверки."
    },
    {
      "g": "test",
      "id": "probe",
      "row": 7,
      "col": 0,
      "type": "process",
      "title": "Выполнить принудительную HTTPS-пробу",
      "body": "Именно кандидат / полная цепочка",
      "note": "Не через текущий глобальный узел и без direct fallback. GET, TLS validation, deadline, байтовый лимит, разрешённые redirects; обход локального кеша. Не передавать cookies или пользовательские токены."
    },
    {
      "g": "test",
      "id": "body",
      "row": 8,
      "col": 0,
      "type": "process",
      "title": "Проверить ответ и передачу",
      "body": "Статус + тело; cold/warm раздельно",
      "note": "204 — успех без тела по профилю. Favicon — ожидаемый 200 и завершённое изображение; HTML/login/заглушка не успех. Отдельно TTFB, байты, длительность чтения и этап ошибки."
    },
    {
      "g": "test",
      "id": "data",
      "row": 9,
      "col": 0,
      "type": "process",
      "title": "Проверить данные перед сменой",
      "body": "Ограниченный GET + требования маршрута",
      "note": "64–256 КиБ — начальная гипотеза для испытаний; отдельный контролируемый объект и общий deadline, лимит даже при игнорировании Range. При необходимости DNS/UDP. Долгие сессии — ручные/лабораторные тесты."
    },
    {
      "g": "test",
      "id": "result",
      "row": 10,
      "col": 0,
      "type": "decision",
      "title": "Профиль пройден?",
      "body": "По всем обязательным критериям",
      "note": ""
    },
    {
      "g": "test",
      "id": "reject",
      "row": 10,
      "col": 1,
      "type": "process",
      "title": "Записать конкретную причину",
      "body": "Не исключать узел из всех профилей",
